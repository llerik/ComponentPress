# Пример проекта второго этапа
schema_version: 9
id: demo-game
name: "Лесная игра"
version: "0.1.0"
variables:
  edition: "Первый прототип"
images:
  - assets/images/leaf.png
icons:
  ic_leaf_6:
    path: assets/images/leaf.png
data_source: null
copies_columns:
  prod: Prod
  test: Debug
components:
  - id: forest-card
    path: components/forest-card.yaml
print:
  paper: A4
  orientation: portrait
  margin_mm: 5
  gap_mm: 3
  dpi: 300
  cut_lines: true
  cut_line_width_mm: 0.2
